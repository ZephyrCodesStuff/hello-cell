{
    "arch": "powerpc64",
    "data-layout": "E-m:e-Fi64-i64:64-i128:128-n32:64",
    "llvm-target": "powerpc64-sony-ps3",
    "llvm-abiname": "elfv1",
    "target-endian": "big",
    "target-pointer-width": 64,
    "target-c-int-width": 32,
    "os": "ps3",
    "abi": "elfv1",
    "executables": true,
    "exe-suffix": ".ELF",
    "linker-flavor": "gnu",
    "linker": "mold",
    "relocation-model": "static",
    "code-model": "small",
    "panic-strategy": "abort",
    "disable-redzone": false,
    "features": "+altivec",
    "frame-pointer": "may-omit",
    "relax-elf-relocations": false
}